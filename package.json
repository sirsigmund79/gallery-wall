    "test:watch": "vitest",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "preview:host": "vite preview --mode lan",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium-mobile"
  },
  "dependencies": {
